#!/bin/bash

# ==============================================================================
# Script di Installazione per zeroCAM
# ==============================================================================
# Questo script automatizza l'installazione di zeroCAM su sistemi basati su
# Debian, come Raspberry Pi OS.
# ==============================================================================

set -e # Esce immediatamente se un comando fallisce

# --- Variabili di Configurazione ---
INSTALL_DIR="/usr/local/zerocam"
APP_DIR="$INSTALL_DIR/app"
VENV_DIR="$INSTALL_DIR/venv"
# Dati che devono sopravvivere agli aggiornamenti: configurazione, .env, log,
# fotogrammi del timelapse, immagini archiviate. Stanno fuori da APP_DIR, che
# a ogni installazione viene rimossa e riscritta.
DATA_DIR="$INSTALL_DIR/data"
# Quanto le versioni fino alla 'app-only' tenevano dentro APP_DIR.
LEGACY_DATA_ITEMS=(.conf.json .privacy_mask.json .env .capture_info latest.jpg logs images timelapse_frames timelapse)

# --- Funzioni di Utility per l'Output ---
echo_step() {
    echo " "
    echo "=============================================================================="
    echo "➡️  $1"
    echo "=============================================================================="
}

echo_info() {
    echo "   [INFO] $1"
}

echo_success() {
    echo "   [SUCCESS] $1"
}

echo_warning() {
    echo "   [WARNING] $1"
}

# Controlla se lo script è eseguito come root
if [ "$(id -u)" -ne 0 ]; then
    echo "Questo script deve essere eseguito con i privilegi di sudo."
    exit 1
fi

# Serve sapere per quale utente si sta installando: il servizio gira come
# lui, ed è il suo nome che finisce nella regola sudoers, in quella polkit e
# nella proprietà dei file. Da una shell di root SUDO_USER è vuoto, e il
# risultato sarebbero regole che non autorizzano nessuno - senza che nulla
# lo segnali, finché la pagina di rete non riesce a salvare.
if [ -z "$SUDO_USER" ] || [ "$SUDO_USER" = "root" ]; then
    echo "Questo script va lanciato con 'sudo' da un utente normale, non da una"
    echo "shell di root: il servizio deve girare come quell'utente."
    echo "  sudo bash zeroCamInstall"
    exit 1
fi

# Il sistema deve essere Bookworm o successivo, dove la rete la gestisce
# NetworkManager. Sulle versioni precedenti (dhcpcd e wpa_supplicant) la
# pagina Network non ha nessuno con cui parlare e l'hotspot di appoggio non
# può esistere: meglio fermarsi adesso che consegnare una webcam che non si
# riesce a configurare.
if ! command -v nmcli >/dev/null; then
    echo "NetworkManager non è presente su questo sistema."
    echo "zeroCAM richiede Raspberry Pi OS a 64 bit basato su Debian Bookworm o successivo."
    if [ -r /etc/os-release ]; then
        . /etc/os-release
        echo "Trovato invece: ${PRETTY_NAME:-sconosciuto}"
    fi
    exit 1
fi

# Chiede la versione da installare
echo_step "Benvenuto nell'installatore di zeroCAM"
read -p "Inserisci il tag della versione da installare (es. v0.0.1): " RELEASE_TAG
if [ -z "$RELEASE_TAG" ]; then
    echo "Il tag della versione non può essere vuoto. Uscita."
    exit 1
fi
RELEASE_URL="https://github.com/iz1kga/zeroCam/releases/download/${RELEASE_TAG}/zeroCam_${RELEASE_TAG}.zip"

# Passo 1: Installazione delle dipendenze di sistema
# ==============================================================================
echo_step "Passo 1: Installazione delle dipendenze di sistema..."
apt-get update
apt-get install -y \
    build-essential libcap-dev python3-dev python3-setuptools python3-venv \
    libsoup2.4-1 libsoup-gnome2.4-1 vim libcamera-apps libcamera-dev \
    python3-libcamera gir1.2-gst-rtsp-server-1.0 python3-picamera2 gstreamer1.0-tools \
    gstreamer1.0-plugins-bad gstreamer1.0-libcamera gstreamer1.0-rtsp \
    gstreamer1.0-plugins-good gstreamer1.0-plugins-base python3-gi \
    python3-gst-1.0 gstreamer1.0-plugins-ugly gstreamer1.0-libav wireguard \
    ffmpeg libcamera-tools wget unzip jq openssl uuid-runtime \
    avahi-daemon rfkill
echo_success "Dipendenze di sistema installate."

# Passo 2: Arresto del servizio esistente (se presente)
# ==============================================================================
echo_step "Passo 2: Controllo e arresto del servizio zeroCAM esistente..."
if systemctl list-units --type=service | grep -q "zerocam.service"; then
    if systemctl is-active --quiet zerocam.service; then
        echo_info "Servizio zeroCAM trovato e in esecuzione. Lo fermo..."
        systemctl stop zerocam.service
        echo_success "Servizio zeroCAM arrestato."
    else
        echo_info "Servizio zeroCAM trovato ma non in esecuzione."
    fi
else
    echo_info "Nessun servizio zeroCAM esistente trovato. Proseguo."
fi

# Passo 3: Creazione della directory di installazione
# ==============================================================================
echo_step "Passo 3: Creazione della directory di installazione..."
mkdir -p "$INSTALL_DIR"
chown -R "$SUDO_USER:$SUDO_USER" "$INSTALL_DIR"
echo_success "Proprietario di $INSTALL_DIR impostato a $SUDO_USER."

# Passo 4: Creazione dell'ambiente virtuale Python
# ==============================================================================
echo_step "Passo 4: Creazione dell'ambiente virtuale Python..."
if [ -d "$VENV_DIR" ]; then
    echo_info "Ambiente virtuale già esistente. Lo riutilizzo."
else
    sudo -u "$SUDO_USER" python3 -m venv "$VENV_DIR" --system-site-packages
    echo_success "Ambiente virtuale creato in $VENV_DIR."
fi

# Passo 5: Messa al sicuro dei dati e pulizia di una installazione precedente
# ==============================================================================
echo_step "Passo 5: Gestione di installazioni precedenti..."
mkdir -p "$DATA_DIR"
if [ -d "$APP_DIR" ]; then
    echo_warning "Trovata un'installazione precedente."

    # Esegue l'unmount di shmem se necessario
    if mountpoint -q "$APP_DIR/shmem"; then
        echo_info "Eseguo l'unmount di $APP_DIR/shmem..."
        umount "$APP_DIR/shmem"
        echo_success "Unmount completato."
    fi

    # Fino alla versione precedente configurazione, log e fotogrammi stavano
    # dentro la cartella dell'applicazione, che qui viene rimossa: quello che
    # non è ancora nella cartella dei dati va spostato adesso, altrimenti si
    # perde (è così che sono spariti i fotogrammi del timelapse).
    for ITEM in "${LEGACY_DATA_ITEMS[@]}"; do
        if [ -e "$APP_DIR/$ITEM" ] && [ ! -e "$DATA_DIR/$ITEM" ]; then
            mv "$APP_DIR/$ITEM" "$DATA_DIR/"
            echo_success "$ITEM spostato in $DATA_DIR."
        fi
    done

    rm -rf "$APP_DIR"
    echo_info "Vecchia directory dell'applicazione rimossa."
fi

# Passo 6: Download ed estrazione dell'applicazione
# ==============================================================================
echo_step "Passo 6: Download ed estrazione di zeroCAM $RELEASE_TAG..."
mkdir -p "$APP_DIR"
TEMP_ZIP=$(mktemp)
wget -O "$TEMP_ZIP" "$RELEASE_URL"
unzip "$TEMP_ZIP" -d "$APP_DIR"
rm "$TEMP_ZIP"
# Il tag installato e' l'unica fonte attendibile della versione: l'archivio
# potrebbe non avere il segnaposto sostituito.
echo "$RELEASE_TAG" > "$APP_DIR/VERSION"
echo_success "Applicazione $RELEASE_TAG estratta in $APP_DIR."

# Passo 7: Configurazione nella cartella dei dati
# ==============================================================================
echo_step "Passo 7: Configurazione..."
# La release porta con sé una configurazione di default: se ne esiste già una
# le si sovrappone, così le chiavi nuove entrano senza toccare le impostazioni
# in uso. La copia della release non serve oltre.
if [ -f "$APP_DIR/.conf.json" ]; then
    if [ -f "$DATA_DIR/.conf.json" ]; then
        TEMP_MERGED=$(mktemp)
        jq -s '.[0] * .[1]' "$APP_DIR/.conf.json" "$DATA_DIR/.conf.json" > "$TEMP_MERGED"
        mv "$TEMP_MERGED" "$DATA_DIR/.conf.json"
        echo_success "Configurazione esistente aggiornata con le chiavi della nuova versione."
    else
        mv "$APP_DIR/.conf.json" "$DATA_DIR/.conf.json"
        echo_success "Configurazione iniziale installata in $DATA_DIR."
    fi
    rm -f "$APP_DIR/.conf.json"
fi
chown -R "$SUDO_USER:$SUDO_USER" "$APP_DIR" "$DATA_DIR"

# Passo 8: Configurazione della memoria condivisa (tmpfs)
# ==============================================================================
echo_step "Passo 8: Configurazione della memoria condivisa (tmpfs)..."
mkdir -p "$APP_DIR/shmem"
chown "$SUDO_USER:$SUDO_USER" "$APP_DIR/shmem" # Assicura la proprietà corretta
FSTAB_LINE="tmpfs $APP_DIR/shmem tmpfs defaults,noatime,nosuid,size=25M 0 0"
if ! grep -qF "$FSTAB_LINE" /etc/fstab; then
    echo "$FSTAB_LINE" >> /etc/fstab
    echo_success "Riga tmpfs aggiunta a /etc/fstab."
fi
mount -a
echo_success "Mountpoint attivati."

# Passo 9: Installazione delle dipendenze Python
# ==============================================================================
echo_step "Passo 9: Installazione delle dipendenze Python..."
if [ -f "$APP_DIR/requirements.txt" ]; then
    sudo -u "$SUDO_USER" "$VENV_DIR/bin/pip" install -r "$APP_DIR/requirements.txt"
    echo_success "Dipendenze Python installate."
else
    echo_warning "File requirements.txt non trovato."
fi

# Passo 10: Configurazione iniziale e sicurezza
# ==============================================================================
echo_step "Passo 10: Configurazione iniziale e sicurezza..."

ENV_FILE="$DATA_DIR/.env"

if [ ! -f "$ENV_FILE" ]; then
    echo_info "File .env non trovato. Lo creo da zero..."
    DEVICE_ID=$(uuidgen)
    ZEROCAM_SECRET_KEY=$(openssl rand -hex 32)
    sudo -u "$SUDO_USER" bash -c "cat > '$ENV_FILE' <<EOL
DEVICE_ID=$DEVICE_ID
ZEROCAM_SECRET_KEY=$ZEROCAM_SECRET_KEY
EOL"
    chmod 600 "$ENV_FILE"
    echo_success "File .env creato con successo."
else
    echo_info "File .env esistente. Verifico le chiavi..."
    if ! grep -q "^DEVICE_ID=" "$ENV_FILE"; then
        echo_info "DEVICE_ID mancante. Lo genero e lo aggiungo."
        DEVICE_ID=$(uuidgen)
        echo "DEVICE_ID=$DEVICE_ID" >> "$ENV_FILE"
    else
        echo_success "DEVICE_ID già presente."
    fi
    if ! grep -q "^ZEROCAM_SECRET_KEY=" "$ENV_FILE"; then
        echo_info "ZEROCAM_SECRET_KEY mancante. La genero e la aggiungo."
        ZEROCAM_SECRET_KEY=$(openssl rand -hex 32)
        echo "ZEROCAM_SECRET_KEY=$ZEROCAM_SECRET_KEY" >> "$ENV_FILE"
    else
        echo_success "ZEROCAM_SECRET_KEY già presente."
    fi
fi

# Controlla se la password è già impostata nel file .conf.json
PASSWORD_SET="false"
if [ -f "$DATA_DIR/.conf.json" ]; then
    PASSWORD_SET=$(jq 'if .security and .security.password and (.security.password | length > 0) then true else false end' "$DATA_DIR/.conf.json")
fi

if [ "$PASSWORD_SET" != "true" ]; then
    echo_info "Impostazione della password dell'applicazione..."
    while true; do
        read -s -p "Inserisci una nuova password: " PASSWORD
        echo
        read -s -p "Conferma la password: " PASSWORD_CONFIRM
        echo
        if [ "$PASSWORD" = "$PASSWORD_CONFIRM" ]; then
            break
        else
            echo "Le password non coincidono. Riprova."
        fi
    done
    PASSWORD_HASH=$("$VENV_DIR/bin/python" -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('$PASSWORD'))")
    jq ".security.password = \"$PASSWORD_HASH\"" "$DATA_DIR/.conf.json" > "${DATA_DIR}/.conf.json.tmp" && mv "${DATA_DIR}/.conf.json.tmp" "$DATA_DIR/.conf.json"
    chown "$SUDO_USER:$SUDO_USER" "$DATA_DIR/.conf.json" # Assicura la proprietà corretta dopo la modifica
    echo_success "Password dell'applicazione impostata e salvata."
else
    echo_info "Una password per l'applicazione è già impostata. Salto questo passaggio."
fi

# Passo 11: Configurazione di sudo per il riavvio senza password
# ==============================================================================
echo_step "Passo 11: Configurazione di sudo per il riavvio..."
SUDOERS_FILE="/etc/sudoers.d/010_zerocam-reboot"
if [ ! -f "$SUDOERS_FILE" ]; then
    echo "$SUDO_USER ALL=(ALL) NOPASSWD: /sbin/reboot" > "$SUDOERS_FILE"
    chmod 440 "$SUDOERS_FILE"
    echo_success "Regola sudoers per il riavvio creata."
else
    echo_info "Regola sudoers per il riavvio già presente."
fi

# Passo 12: Identità sulla rete
# ==============================================================================
echo_step "Passo 12: Identità sulla rete..."

# Il suffisso viene dal seriale del Raspberry: è stabile, si può stampare
# sull'etichetta prima ancora di accendere la webcam, e rende impossibile
# che due dispositivi accesi vicini si contendano lo stesso nome. Senza,
# Avahi risolverebbe il conflitto da sé rinominando il secondo in
# 'zerocam-2', ma quale sia il secondo dipende dall'ordine di accensione.
SERIAL=$(awk '/^Serial/ {print $3}' /proc/cpuinfo 2>/dev/null | tail -1)
if [ -n "$SERIAL" ]; then
    SUFFIX="${SERIAL: -4}"
else
    MAC=$(cat /sys/class/net/eth0/address 2>/dev/null || true)
    MAC="${MAC//:/}"
    SUFFIX="${MAC: -4}"
fi
SUFFIX=$(echo "$SUFFIX" | tr 'A-Z' 'a-z')
if [ -z "$SUFFIX" ]; then
    SUFFIX=$(openssl rand -hex 2)
    echo_warning "Seriale non leggibile: il suffisso è stato estratto a caso."
fi
DEVICE_NAME="zerocam-$SUFFIX"

# Un hostname già cambiato a mano non si tocca: è una scelta di chi ha
# preparato il dispositivo, e sovrascriverla romperebbe il nome che
# qualcuno potrebbe già aver scritto sull'etichetta.
CURRENT_HOSTNAME=$(hostname)
if [ "$CURRENT_HOSTNAME" = "raspberrypi" ] || [ -z "$CURRENT_HOSTNAME" ]; then
    if command -v raspi-config >/dev/null; then
        # raspi-config sistema anche la riga 127.0.1.1 di /etc/hosts, che
        # hostnamectl da solo lascia indietro: senza, ogni sudo si porta
        # dietro 'unable to resolve host'.
        raspi-config nonint do_hostname "$DEVICE_NAME"
    else
        hostnamectl set-hostname "$DEVICE_NAME"
        sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$DEVICE_NAME/" /etc/hosts
    fi
    echo_success "Hostname impostato a $DEVICE_NAME (raggiungibile come $DEVICE_NAME.local)."
else
    DEVICE_NAME="$CURRENT_HOSTNAME"
    echo_info "Hostname già impostato a $DEVICE_NAME: lo lascio com'è."
fi

systemctl enable --now avahi-daemon >/dev/null 2>&1 || true
echo_success "Avahi attivo: il dispositivo risponde a $DEVICE_NAME.local."

# L'annuncio del servizio web porta il nome leggibile della webcam, quello
# di Device Details. Lo riscrive l'applicazione quando cambia, quindi il
# file deve appartenere all'utente del servizio: la cartella resta di root.
mkdir -p /etc/avahi/services
AVAHI_SERVICE="/etc/avahi/services/zerocam.service"
if [ ! -f "$AVAHI_SERVICE" ]; then
    cat > "$AVAHI_SERVICE" <<EOL
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Scritto da zeroCAM: le modifiche a mano vengono sovrascritte. -->
<service-group>
  <name>zeroCAM $SUFFIX</name>
  <service>
    <type>_http._tcp</type>
    <port>8080</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
EOL
fi
chown "$SUDO_USER:$SUDO_USER" "$AVAHI_SERVICE"
echo_success "Annuncio del servizio web creato."

# Passo 13: Permessi per configurare la rete
# ==============================================================================
echo_step "Passo 13: Permessi per configurare la rete..."

# Il servizio gira come utente normale: senza questa regola ogni comando
# nmcli che scrive verrebbe rifiutato, e la pagina Network potrebbe solo
# leggere. polkit vuole una regola in JavaScript, perché da bookworm i
# vecchi file .pkla non sono più supportati.
POLKIT_RULE="/etc/polkit-1/rules.d/50-zerocam-network.rules"
mkdir -p /etc/polkit-1/rules.d
cat > "$POLKIT_RULE" <<EOL
// zeroCAM configura la rete dalla sua interfaccia web: il servizio gira
// come $SUDO_USER e senza questa regola polkit gli rifiuterebbe ogni
// modifica. L'autorizzazione vale solo per quell'utente e solo per
// NetworkManager.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0 &&
        subject.user == "$SUDO_USER") {
        return polkit.Result.YES;
    }
});
EOL
chmod 644 "$POLKIT_RULE"
# Il gruppo netdev è quello che NetworkManager riconosce di suo: non basta
# da solo per un servizio senza sessione, ma non guasta.
usermod -aG netdev "$SUDO_USER" 2>/dev/null || true
echo_success "Regola polkit creata per $SUDO_USER."

# Senza il paese la radio resta bloccata da rfkill e l'hotspot non parte
# mai. Va impostato qui, perché nessuno lo farà da riga di comando dopo.
CURRENT_COUNTRY=$(raspi-config nonint get_wifi_country 2>/dev/null || true)
if [ -z "$CURRENT_COUNTRY" ] || [ "$CURRENT_COUNTRY" = "0" ]; then
    read -p "Codice del paese per il wifi (due lettere) [IT]: " WIFI_COUNTRY
    WIFI_COUNTRY=$(echo "${WIFI_COUNTRY:-IT}" | tr 'a-z' 'A-Z')
    raspi-config nonint do_wifi_country "$WIFI_COUNTRY" || \
        echo_warning "Impostazione del paese non riuscita: l'hotspot potrebbe non partire."
    echo_success "Paese del wifi impostato a $WIFI_COUNTRY."
else
    echo_info "Paese del wifi già impostato a $CURRENT_COUNTRY."
fi
rfkill unblock wifi 2>/dev/null || true

# Passo 14: Hotspot di appoggio
# ==============================================================================
echo_step "Passo 14: Hotspot di appoggio..."

# Il nome e la password vanno stampati sull'etichetta prima di spedire la
# webcam, quindi si decidono qui e non alla prima accensione: quando il
# dispositivo arriva a destinazione l'etichetta esiste già.
# Il nome della rete si ricava dall'hostname vero e non dal seriale: su un
# dispositivo ribattezzato a mano i due non coincidono, e l'etichetta
# finirebbe per dire 'zerocam-lago.local' accanto a 'zeroCAM-a1b2'. È la
# stessa regola che l'applicazione applica quando il nome non è imposto.
case "$DEVICE_NAME" in
    zerocam*) HOTSPOT_SSID="zeroCAM${DEVICE_NAME#zerocam}" ;;
    *)        HOTSPOT_SSID="zeroCAM-$DEVICE_NAME" ;;
esac
HOTSPOT_PASSWORD=$(jq -r '.network.hotspot_password // ""' "$DATA_DIR/.conf.json" 2>/dev/null || echo "")

if [ -z "$HOTSPOT_PASSWORD" ]; then
    # Niente i, l, o, 0 e 1: su un'etichetta stampata si confondono, e
    # chi la digita sul telefono sbaglia.
    HOTSPOT_PASSWORD=$(tr -dc 'a-hj-km-np-z2-9' </dev/urandom | head -c 10)
    TEMP_CONF=$(mktemp)
    jq --arg ssid "$HOTSPOT_SSID" --arg pw "$HOTSPOT_PASSWORD" \
       '.network = (.network // {}) | .network.hotspot_enabled = true |
        .network.hotspot_ssid = $ssid | .network.hotspot_password = $pw |
        .network.hotspot_delay = (.network.hotspot_delay // 120)' \
       "$DATA_DIR/.conf.json" > "$TEMP_CONF" && mv "$TEMP_CONF" "$DATA_DIR/.conf.json"
    chown "$SUDO_USER:$SUDO_USER" "$DATA_DIR/.conf.json"
    echo_success "Hotspot configurato come $HOTSPOT_SSID."
else
    HOTSPOT_SSID=$(jq -r '.network.hotspot_ssid // ""' "$DATA_DIR/.conf.json")
    # Dopo un salvataggio dall'interfaccia la password è cifrata con
    # ZEROCAM_SECRET_KEY: stamparla così com'è metterebbe 'enc:gAAAA...'
    # sull'etichetta. Si legge dall'interfaccia, che la decifra.
    case "$HOTSPOT_PASSWORD" in
        enc:*) HOTSPOT_PASSWORD="(invariata: leggila in Configuration -> Network)" ;;
    esac
    echo_info "Hotspot già configurato: lascio nome e password com'erano."
fi

# Passo 15: Creazione e avvio del servizio systemd
# ==============================================================================
echo_step "Passo 15: Creazione e avvio del servizio systemd..."
SERVICE_FILE="/etc/systemd/system/zerocam.service"
cat > "$SERVICE_FILE" <<EOL
[Unit]
Description=zeroCAM Service
# NetworkManager deve essere in piedi prima: la sorveglianza della rete lo
# interroga appena parte, e senza troverebbe un sistema che non risponde
# proprio nel momento in cui deve decidere se accendere l'hotspot.
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
User=$SUDO_USER
Group=$SUDO_USER
WorkingDirectory=$APP_DIR
Environment=ZEROCAM_DATA_DIR=$DATA_DIR
EnvironmentFile=$DATA_DIR/.env
ExecStart=$VENV_DIR/bin/python zeroCam.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOL

systemctl daemon-reload
systemctl enable zerocam.service
systemctl start zerocam.service

echo_success "Servizio zeroCAM creato, abilitato e avviato."
echo_step "Installazione completata!"

# Chi prepara la webcam la spedisce a qualcun altro, che l'accenderà dove
# non c'è nessuna rete conosciuta: questi quattro valori sono tutto ciò che
# gli serve, e vanno sull'etichetta prima che il dispositivo parta.
echo " "
echo "  Da riportare sull'etichetta del dispositivo"
echo "  ------------------------------------------"
echo "  Indirizzo:          http://$DEVICE_NAME.local:8080/"
echo "  Rete di appoggio:   $HOTSPOT_SSID"
echo "  Password della rete: $HOTSPOT_PASSWORD"
echo "  Indirizzo da hotspot: http://10.42.0.1:8080/"
echo " "
echo "  L'utente si collega alla rete di appoggio, apre il secondo indirizzo"
echo "  e indica da lì il proprio wifi. La rete di appoggio compare da sola"
echo "  quando la webcam non trova nessuna rete conosciuta."
echo " "
echo "  La password dell'hotspot non viene più mostrata: è in Configuration"
echo "  -> Network nell'interfaccia web."
echo " "

# L'etichetta vera e propria, con i due QR: uno porta le credenziali della
# rete di appoggio, l'altro l'indirizzo dell'interfaccia. Un QR solo non
# può fare entrambe le cose. Se qualcosa va storto l'installazione è già
# finita e i valori sono qui sopra: non c'è motivo di fallire adesso.
LABEL_SCRIPT="$APP_DIR/installation_tools/genera_etichetta.py"
LABEL_FILE="$DATA_DIR/etichetta-$DEVICE_NAME.png"
case "$HOTSPOT_PASSWORD" in
    "("*)
        echo_info "Password non in chiaro: l'etichetta si rigenera con"
        echo_info "  $VENV_DIR/bin/python $LABEL_SCRIPT --help"
        ;;
    *)
        if [ -f "$LABEL_SCRIPT" ] && "$VENV_DIR/bin/python" "$LABEL_SCRIPT" \
            --hostname "$DEVICE_NAME" --ssid "$HOTSPOT_SSID" \
            --password "$HOTSPOT_PASSWORD" --output "$LABEL_FILE" 2>/dev/null; then
            chown "$SUDO_USER:$SUDO_USER" "$LABEL_FILE"
            echo_success "Etichetta da stampare salvata in $LABEL_FILE"
        else
            echo_warning "Etichetta non generata: i valori restano quelli qui sopra."
        fi
        ;;
esac
echo " "

